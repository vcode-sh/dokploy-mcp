# Dokploy credentials
DOKPLOY_URL=https://panel.example.com
DOKPLOY_API_KEY=
DOKPLOY_TIMEOUT=30000
DOKPLOY_PROFILES_JSON=

# Server mode and capabilities
DOKPLOY_MCP_TRANSPORT=stdio
DOKPLOY_MCP_MODE=codemode
DOKPLOY_ENABLED_TAGS=
DOKPLOY_MCP_CAPABILITIES=
DOKPLOY_MCP_GATEWAY_RETRIES=2

# Hosted HTTP transport
DOKPLOY_MCP_HTTP_HOST=127.0.0.1
DOKPLOY_MCP_HTTP_PORT=3000
DOKPLOY_MCP_HTTP_PATH=/mcp
DOKPLOY_MCP_HEALTH_PATH=/health
DOKPLOY_MCP_ALLOWED_ORIGINS=
DOKPLOY_MCP_HTTP_ALLOW_CONFIG_FALLBACK=false

# Sandbox runtime and limits
DOKPLOY_MCP_SANDBOX_RUNTIME=subprocess
DOKPLOY_MCP_SANDBOX_TIMEOUT_MS=3000
DOKPLOY_MCP_SANDBOX_MAX_CALLS=40
DOKPLOY_MCP_SANDBOX_MAX_RESULT_BYTES=1048576
DOKPLOY_MCP_SANDBOX_MAX_RESPONSE_BYTES=1048576
DOKPLOY_MCP_SANDBOX_MAX_LOG_BYTES=65536
DOKPLOY_MCP_SANDBOX_MAX_HEAP_DELTA_BYTES=16777216
DOKPLOY_MCP_SANDBOX_MAX_CONCURRENT=4
DOKPLOY_MCP_SANDBOX_WORKER_MEMORY_MB=256
DOKPLOY_MCP_SANDBOX_WORKER_PATH=
